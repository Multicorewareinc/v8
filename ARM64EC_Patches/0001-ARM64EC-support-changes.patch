diff --git a/src/codegen/arm64/macro-assembler-arm64.cc b/src/codegen/arm64/macro-assembler-arm64.cc
index ca52e6ecca7..9f171d46646 100644
--- a/src/codegen/arm64/macro-assembler-arm64.cc
+++ b/src/codegen/arm64/macro-assembler-arm64.cc
@@ -1783,6 +1783,40 @@ void TurboAssembler::CallCFunction(Register function, int num_of_reg_args,
 
   Pop(addr_scratch, pc_scratch);
 
+  // Skip FFS sequence for external functions in ARM64EC mode.
+  {
+    Register tmp = x10;
+    Push(tmp, xzr);
+    Label no_adjust;
+
+    // Check following code:
+    /*
+      488bc4          mov     rax,rsp
+      48895820        mov     qword ptr [rax+20h],rbx
+      55              push    rbp
+    */
+    Ldr(tmp, MemOperand(function, 0));
+    Cmp(tmp, Immediate(0x5520588948c48b48ULL));
+    B(ne, &no_adjust);
+
+    /*
+      5d              pop     rbp
+      e9xxxxxxxx      jmp     xxx
+    */
+    Ldrh(tmp.W(), MemOperand(function, 8));
+    Cmp(tmp.W(), Immediate(0xe95d));
+    B(ne, &no_adjust);
+
+    // Adjust function to point to the actual target.
+    Ldrsw(tmp, MemOperand(function, 10));
+    Add(function, function, 14);  // Skip the jump instruction.
+    Add(function, function, tmp);
+
+    Bind(&no_adjust);
+    Pop(xzr, tmp);
+  }
+
+
   // Call directly. The function called cannot cause a GC, or allow preemption,
   // so the return address in the link register stays correct.
   Call(function);
