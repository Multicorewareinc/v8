+#if (defined(_M_X64) || defined(__x86_64__) || defined(_M_ARM64)) && !defined(_M_ARM64EC)
   return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
-                       nullptr, 0);
+  nullptr, 0);
+#elif defined(_M_ARM64EC)
+  OS::EnsureWin32MemoryAPILoaded();
+  if (protect == (PAGE_EXECUTE_READWRITE | PAGE_TARGETS_INVALID)
+  || protect == (PAGE_EXECUTE_READ | PAGE_TARGETS_INVALID)) {
+    MEM_EXTENDED_PARAMETER Parameter = { 0 };
+    Parameter.Type = MemExtendedParameterAttributeFlags;
+    Parameter.ULong64 = MEM_EXTENDED_PARAMETER_EC_CODE;
+    return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
+                        &Parameter, 1);
+  } else {
+    return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
+    nullptr, 0);
+  }
+#endif
 }
 
