diff --git a/src/base/platform/platform-win32.cc b/src/base/platform/platform-win32.cc
index 4857a25027f..eb4f17d7ae3 100644
--- a/src/base/platform/platform-win32.cc
+++ b/src/base/platform/platform-win32.cc
@@ -867,12 +867,35 @@ DWORD GetFileViewAccessFromMemoryPermission(OS::MemoryPermission access) {
 
 void* VirtualAllocWrapper(void* address, size_t size, DWORD flags,
                           DWORD protect) {
-  if (VirtualAlloc2) {
-    return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
-                         NULL, 0);
-  } else {
-    return VirtualAlloc(address, size, flags, protect);
-  }
+#if (defined(_M_X64) || defined(__x86_64__) || defined(_M_ARM64)) && !defined(_M_ARM64EC)
+    if (VirtualAlloc2) {
+      return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
+                          nullptr, 0);
+    } else {
+      return VirtualAlloc(address, size, flags, protect);
+    }
+#elif defined(_M_ARM64EC)
+    OS::EnsureWin32MemoryAPILoaded();
+    if (protect == (PAGE_EXECUTE_READWRITE | PAGE_TARGETS_INVALID)
+    || protect == (PAGE_EXECUTE_READ | PAGE_TARGETS_INVALID)) {
+      if (VirtualAlloc2) {
+        MEM_EXTENDED_PARAMETER Parameter = { 0 };
+        Parameter.Type = MemExtendedParameterAttributeFlags;
+        Parameter.ULong64 = MEM_EXTENDED_PARAMETER_EC_CODE;
+        return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
+                            &Parameter, 1);
+      }
+      // Fallback if VirtualAlloc2 is unavailable
+      return VirtualAlloc(address, size, flags, protect);
+    } else {
+      if (VirtualAlloc2) {
+        return VirtualAlloc2(GetCurrentProcess(), address, size, flags, protect,
+                            nullptr, 0);
+      } else {
+        return VirtualAlloc(address, size, flags, protect);
+      }
+    }
+#endif
 }
 
